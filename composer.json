{
  "name": "bs-community/blessing-skin-server",
  "description": "A web application brings your custom skins back in offline Minecraft servers.",
  "license": "MIT",
  "require": {
    "php": "^8.3",
    "ext-ctype": "*",
    "ext-curl": "*",
    "ext-dom": "*",
    "ext-fileinfo": "*",
    "ext-gd": "*",
    "ext-imagick": "*",
    "ext-json": "*",
    "ext-mbstring": "*",
    "ext-openssl": "*",
    "ext-pdo": "*",
    "ext-tokenizer": "*",
    "ext-xml": "*",
    "ext-zip": "*",
    "blessing/filter": "^1.4",
    "blessing/rejection": "^1.4",
    "blessing/texture-renderer": "^0.2",
    "composer/ca-bundle": "^1.5",
    "composer/semver": "^3.4",
    "doctrine/inflector": "^2.0",
    "gregwar/captcha": "^2.1",
    "guzzlehttp/guzzle": "^7.9",
    "intervention/image": "^2.7",
    "laravel/framework": "^13.0",
    "laravel/passport": "^13.10",
    "lorisleiva/laravel-search-string": "^1.3",
    "nesbot/carbon": "^3.8",
    "nunomaduro/collision": "^8.9",
    "rcrowe/twigbridge": "^0.14.8",
    "spatie/laravel-ignition": "^2.12",
    "spatie/laravel-translation-loader": "^2.8",
    "symfony/process": "^7.4",
    "symfony/yaml": "^7.4",
    "twig/twig": "^3.21",
    "vectorface/whip": "^0.5"
  },
  "require-dev": {
    "barryvdh/laravel-debugbar": "^4.4",
    "barryvdh/laravel-ide-helper": "^3.7",
    "fakerphp/faker": "^1.23",
    "friendsofphp/php-cs-fixer": "^3.95",
    "laravel/browser-kit-testing": "^7.2",
    "laravel/tinker": "^3.0",
    "mockery/mockery": "^1.6",
    "phpunit/phpunit": "^13.0",
    "symfony/css-selector": "^7.4",
    "symfony/dom-crawler": "^7.4"
  },
  "autoload": {
    "psr-4": {
      "App\\": "app/",
      "Database\\Factories\\": "database/factories/"
    },
    "files": [
      "app/helpers.php"
    ]
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "post-autoload-dump": [
      "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
      "@php artisan package:discover --ansi"
    ]
  },
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true,
    "allow-plugins": {
      "php-http/discovery": true
    }
  },
  "extra": {
    "laravel": {
      "dont-discover": [
        "laravel/socialite"
      ]
    }
  },
  "repositories": {
    "blessing-filter": {
      "type": "path",
      "url": "packages/blessing-filter",
      "options": {
        "symlink": true
      }
    },
    "blessing-rejection": {
      "type": "path",
      "url": "packages/blessing-rejection",
      "options": {
        "symlink": true
      }
    },
    "laravel-search-string": {
      "type": "path",
      "url": "packages/laravel-search-string",
      "options": {
        "symlink": true
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
